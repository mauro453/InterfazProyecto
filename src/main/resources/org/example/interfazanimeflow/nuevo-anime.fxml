<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="530.0" prefWidth="400.0" style="-fx-background-color: #1F2937;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.interfazanimeflow.NuevoAnimeController">
    <children>
        <VBox layoutX="30.0" layoutY="25.0" prefWidth="340.0" spacing="18.0">
            <children>
                <Label text="Añadir Nuevo Anime" textFill="#3B82F6">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <VBox spacing="6.0">
                    <children>
                        <Label text="Título" textFill="#E5E7EB" />
                        <TextField fx:id="txtTitulo" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8;" />
                    </children>
                </VBox>

                <VBox spacing="6.0">
                    <children>
                        <Label text="Puntuación (1 al 10)" textFill="#E5E7EB" />
                        <TextField fx:id="txtPuntuacion" style="-fx-background-color: #374151; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8;" />
                    </children>
                </VBox>

                <VBox spacing="6.0">
                    <children>
                        <Label text="Descripción" textFill="#E5E7EB" />
                        <TextArea fx:id="txtDescripcion" prefHeight="80.0" promptText="Escribe una breve sinopsis..." style="-fx-control-inner-background: #374151; -fx-text-fill: white; -fx-background-radius: 6;" wrapText="true" />
                    </children>
                </VBox>

                <VBox spacing="6.0">
                    <children>
                        <Label text="Portada del Anime" textFill="#E5E7EB" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="btnSeleccionarFoto" mnemonicParsing="false" onAction="#onSeleccionarFotoClick" style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 6;" text="Buscar imagen...">
                                    <padding>
                                        <Insets bottom="6.0" left="12.0" right="12.0" top="6.0" />
                                    </padding>
                                </Button>
                                <Label fx:id="lblNombreArchivo" text="Ningún archivo seleccionado" textFill="#9CA3AF" wrapText="true" maxWidth="200.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <Label fx:id="lblError" textFill="#EF4444" wrapText="true">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Label>

                <Button fx:id="btnGuardar" maxWidth="1.0" prefHeight="38.0" prefWidth="340.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Guardar Anime" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </children>
</AnchorPane>