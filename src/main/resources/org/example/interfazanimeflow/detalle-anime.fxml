<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" style="-fx-background-color: #1F2937;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.interfazanimeflow.DetalleAnimeController">
    <children>
        <HBox layoutX="25.0" layoutY="25.0" prefHeight="400.0" prefWidth="600.0" spacing="25.0">
            <children>
                <VBox alignment="TOP_CENTER" prefWidth="220.0" style="-fx-background-color: #374151; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0, 0, 5);">
                    <children>
                        <ImageView fx:id="imgPortada" fitHeight="310.0" fitWidth="220.0" preserveRatio="false" />
                        <Label fx:id="lblPuntuacion" text="⭐ 10 / 10" textFill="#F59E0B">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="15.0" />
                            </VBox.margin>
                        </Label>
                    </children>
                </VBox>

                <VBox prefWidth="355.0" spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblTitulo" text="Título del Anime" textFill="WHITE" wrapText="true">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>

                        <VBox prefHeight="1.0" style="-fx-background-color: #4B5563;" />

                        <Label text="Sinopsis" textFill="#3B82F6">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <Label fx:id="lblDescripcion" text="Aquí se mostrará toda la sinopsis completa del anime seleccionado." textFill="#E5E7EB" wrapText="true">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </content>
                        </ScrollPane>
                    </children>
                    <padding>
                        <Insets top="5.0" />
                    </padding>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>